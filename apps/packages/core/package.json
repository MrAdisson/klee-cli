{
  "name": "@klee/core",
  "version": "0.1.0",
  "private": true,
  "description": "Domaine Klee : modules, providers, configuration projet et moteur de scaffolding.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
