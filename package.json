{
  "name": "klee",
  "version": "0.1.0",
  "private": true,
  "description": "Klee — couche de convention et glue tooling qui relie tickets, maquettes, docs et code dans un seul monorepo. CLI: klee.",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "tsc --build --watch",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "klee": "node apps/cli/dist/bin/klee.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.0",
    "eslint": "10.10.0",
    "globals": "^17.12.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
